<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.amine.userController.mainUserViewController"
            prefHeight="700.0" prefWidth="1000.0"
            styleClass="main-container">

    <stylesheets>
        <URL value="@/styles/medintechstyle.css" /> <!-- "@" syntax for relative path -->
    </stylesheets>

    <top>
        <fx:include source="navbar.fxml" />
    </top>

    <center>
        <!-- Main Content Area with Background Image -->
        <StackPane>
            <!-- Background Image -->
            <ImageView fitWidth="1000" fitHeight="650" preserveRatio="false">
                <Image url="/images/section_bg02.jpg"/>
            </ImageView>

            <!-- Content Overlay -->
            <VBox alignment="CENTER" spacing="20">
                <!-- Subtitle -->
                <Label styleClass="subtitle" text="Plateforme unifiée des services publics" textFill="#2ecc71"/>

                <!-- Welcome Title -->
                <Label styleClass="main-title" text="Bienvenue sur" textFill="WHITE"/>

                <!-- Brand Name -->
                <Label styleClass="brand-name" text="MédinTech" textFill="#3498db"/>

                <!-- Description -->
                <Label styleClass="description" wrapText="true" maxWidth="700"
                       text="Une plateforme unifiée pour simplifier l'accès aux services publics d'un gouvernement en ligne, à travers une interface intuitive."
                       textAlignment="CENTER" textFill="WHITE"/>

                <!-- Search Container -->
                <HBox styleClass="search-container" alignment="CENTER" spacing="0">
                    <TextField fx:id="searchField" promptText="Rechercher un service public, une démarche..."
                               styleClass="search-field" HBox.hgrow="ALWAYS"/>
                    <ComboBox fx:id="serviceTypeComboBox" promptText="Tous les services" styleClass="service-combo"/>
                    <Button fx:id="searchButton" text="Rechercher" styleClass="search-button"/>
                </HBox>
            </VBox>
        </StackPane>
    </center>

    <bottom>
        <!-- Footer with Logo -->
        <HBox styleClass="footer" alignment="CENTER">
            <ImageView fitHeight="40" fitWidth="40">
                <Image url="/images/Smart City building outline logo.png"/>
            </ImageView>
        </HBox>
    </bottom>
</BorderPane>