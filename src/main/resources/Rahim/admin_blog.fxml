<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<?import java.net.URL?>
<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.Rahim.AdminBlogController"
            stylesheets="@admin_blog.css">

    <!-- Sidebar -->
    <left>
        <VBox fx:id="sidebar" styleClass="sidebar" spacing="20">
            <Label text="Admin Dashboard" styleClass="menu-label" />
            <Button fx:id="dashboardBtn" styleClass="sidebar-button" onAction="#goToDashboard">
                <graphic>
                    <SVGPath content="M12 2L2 12h3v8h6v-6h2v6h6v-8h3L12 2z" style="-fx-fill: white;"/>
                </graphic>
                Dashboard
            </Button>
            <Button fx:id="gestionBlogBtn" styleClass="sidebar-button active" onAction="#loadBlogManagement">
                <graphic>
                    <SVGPath content="M4 9h16v2H4zm0 4h10v2H4z" style="-fx-fill: white;"/>
                </graphic>
                Gestion Blog
            </Button>
        </VBox>
    </left>

    <!-- Main Content -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox fx:id="postsContainer" styleClass="posts-card" spacing="25" alignment="CENTER">
                <Label text="Tous les Articles" styleClass="posts-title" />
                <!-- Example card for an article -->
                <VBox style="-fx-background-color: #f5f8fa; -fx-background-radius: 12; -fx-padding: 18; -fx-spacing: 10; -fx-effect: dropshadow(gaussian, #bbb, 4, 0.1, 0, 2);" prefWidth="500">
                    <Label text="Titre de l'article" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #1B3A57;" />
                    <Label text="Résumé de l'article ou contenu court..." style="-fx-font-size: 14; -fx-text-fill: #333;" />
                    <Button text="Voir plus" style="-fx-background-color: #2d7cff; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 4 18; -fx-cursor: hand; -fx-font-size: 13;" />
                </VBox>
                <!-- End example card -->
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
