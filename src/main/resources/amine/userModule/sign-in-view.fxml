<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.paint.*?>

<ScrollPane fx:id="scrollPane" fitToHeight="true" fitToWidth="true"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.amine.SignInController"
            stylesheets="@prof.css">

    <AnchorPane prefHeight="800.0" prefWidth="1000.0">

        <!-- Background Gradient -->
        <Rectangle width="1000" height="800">
            <fill>
                <LinearGradient startX="0" startY="0" endX="1" endY="1">
                    <stops>
                        <Stop offset="0" color="#0f2027"/>
                        <Stop offset="1" color="#203a43"/>
                    </stops>
                </LinearGradient>
            </fill>
        </Rectangle>

        <!-- Main Content Container -->
        <VBox alignment="TOP_CENTER" spacing="30"
              AnchorPane.topAnchor="40" AnchorPane.bottomAnchor="40"
              AnchorPane.leftAnchor="100" AnchorPane.rightAnchor="100">

            <!-- Header -->
            <HBox alignment="CENTER" spacing="10">
                <Label text="Maintech !" styleClass="app-title"/>
            </HBox>

            <!-- Form Container -->
            <VBox alignment="CENTER" spacing="20" styleClass="form-container">
                <Label text="Sign In" styleClass="form-title"/>

                <!-- Profile Picture Section -->
                <StackPane fx:id="imageContainer" onMouseClicked="#handleChooseImage"
                           styleClass="profile-section">
                    <ImageView fx:id="profileImageView" fitHeight="120" fitWidth="120"
                               preserveRatio="true" styleClass="profile-image"/>
                    <Rectangle arcHeight="10" arcWidth="10" height="120" width="120"
                               styleClass="hover-overlay" opacity="0.7"/>
                    <Label text="Upload Your Image" styleClass="hint-text"/>
                </StackPane>

                <!-- Form Fields Grid -->
                <GridPane hgap="20" vgap="15" alignment="CENTER">
                    <columnConstraints>
                        <ColumnConstraints halignment="RIGHT" minWidth="100"/>
                        <ColumnConstraints halignment="LEFT" minWidth="300"/>
                    </columnConstraints>

                    <!-- Row 0: CIN -->
                    <Label text="CIN:" styleClass="field-label" GridPane.rowIndex="0"/>
                    <TextField fx:id="cinField" styleClass="field-input" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <!-- Row 1: Name -->
                    <Label text="Name:" styleClass="field-label" GridPane.rowIndex="1"/>
                    <TextField fx:id="nameField" styleClass="field-input" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <!-- Row 2: Birthday -->
                    <Label text="Birthday:" styleClass="field-label" GridPane.rowIndex="2"/>
                    <DatePicker fx:id="birthdayPicker" styleClass="date-picker" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <!-- Row 3: Email -->
                    <Label text="Email:" styleClass="field-label" GridPane.rowIndex="3"/>
                    <TextField fx:id="emailField" styleClass="field-input" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <!-- Row 4: Password -->
                    <Label text="Password:" styleClass="field-label" GridPane.rowIndex="4"/>
                    <PasswordField fx:id="passwordField" styleClass="field-input" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                    <!-- Row 5: Phone -->
                    <Label text="Phone:" styleClass="field-label" GridPane.rowIndex="5"/>
                    <TextField fx:id="phoneField" styleClass="field-input" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                    <!-- Row 6: Address -->
                    <Label text="Address:" styleClass="field-label" GridPane.rowIndex="6"/>
                    <TextField fx:id="addressField" styleClass="field-input" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                    <!-- Row 7: Bio -->
                    <Label text="Bio:" styleClass="field-label" GridPane.rowIndex="7"/>
                    <TextField fx:id="bioField" styleClass="bio-textarea" GridPane.rowIndex="7" GridPane.columnIndex="1"/>
                </GridPane>

                <!-- Sign In Button -->
                <Button fx:id="signInButton" onAction="#handleSignIn" text="Sign In"
                        styleClass="primary-button" style="-fx-font-size: 16px;"/>
            </VBox>
        </VBox>

        <!-- Back Button -->
        <Button fx:id="backButton" onAction="#handleBackButton" styleClass="back-button"
                AnchorPane.topAnchor="20" AnchorPane.leftAnchor="20">
            <graphic>
                <ImageView fitHeight="16" fitWidth="16">
                    <Image url="@../images/retournericon.png"/>
                </ImageView>
            </graphic>
        </Button>
    </AnchorPane>
</ScrollPane>