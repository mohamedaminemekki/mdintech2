<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="550.0" prefWidth="500.0"
            style="-fx-background-color: #f4f4f4; -fx-padding: 20px;"
            xmlns:fx="http://javafx.com/fxml/1"
            xmlns="http://javafx.com/javafx/23.0.1"
            fx:controller="controllers.amine.SignInController">

    <VBox alignment="CENTER" layoutX="50.0" layoutY="100.0" prefWidth="400.0" spacing="15"
          style="-fx-background-color: #ffffff; -fx-padding: 30px; -fx-border-radius: 10px; -fx-background-radius: 10px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 4);">

        <Label text="Sign In" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #333;" />

        <ImageView fx:id="profileImageView" fitWidth="100" fitHeight="100" preserveRatio="true" />
        <Button text="Choose Image" onAction="#handleChooseImage" styleClass="image-button"/>

        <TextField fx:id="cinField" promptText="CIN" styleClass="text-field"/>
        <TextField fx:id="nameField" promptText="Name" styleClass="text-field"/>
        <TextField fx:id="emailField" promptText="Email" styleClass="text-field"/>
        <PasswordField fx:id="passwordField" promptText="Password" styleClass="text-field"/>
        <Label fx:id="passwordStrengthLabel" text="" style="-fx-text-fill: red;"/>
        <TextField fx:id="phoneField" promptText="Phone" styleClass="text-field"/>
        <TextField fx:id="addressField" promptText="Address" styleClass="text-field"/>
        <TextField fx:id="cityField" promptText="City" styleClass="text-field"/>
        <TextField fx:id="stateField" promptText="State" styleClass="text-field"/>

        <Button fx:id="signInButton" text="Sign In" onAction="#handleSignIn" styleClass="primary-button"/>
    </VBox>

    <Button layoutX="10" layoutY="10" onAction="#handleBackButton" text="← Back" styleClass="back-button" />
</AnchorPane>
