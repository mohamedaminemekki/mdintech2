<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="Controllers.amine.userController.parking.displayparkingsController"
            prefWidth="700" prefHeight="500"
            style="-fx-background-color: #f4f4f4;">

    <!-- Back Button -->
    <Button layoutX="20" layoutY="20" text="← Back"
            style="-fx-background-color: transparent; -fx-font-size: 14px; -fx-text-fill: #555; -fx-underline: true;"
            onAction="#handleBackButton" />

    <VBox spacing="20" alignment="CENTER"
          AnchorPane.topAnchor="60" AnchorPane.leftAnchor="30" AnchorPane.rightAnchor="30">

        <!-- Header Title -->
        <Label text="Available Parkings"
               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

        <!-- TableView for Parking Data -->
        <TableView fx:id="parkingTableView" prefHeight="350" prefWidth="600"
                   style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 10px; -fx-background-radius: 10px;">

            <columns>
                <TableColumn fx:id="nameColumn" text="Parking Name" prefWidth="300"/>
                <TableColumn fx:id="locationColumn" text="Location" prefWidth="300"/>
            </columns>
        </TableView>
    </VBox>
</AnchorPane>
