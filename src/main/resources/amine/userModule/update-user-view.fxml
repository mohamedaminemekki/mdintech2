<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.amine.userController.updateuserController"
            prefWidth="450" prefHeight="600"
            style="-fx-background-color: #f4f4f4;">

    <!-- Back Button -->
    <Button layoutX="20" layoutY="20" text="← Back"
            style="-fx-background-color: transparent; -fx-font-size: 14px; -fx-text-fill: #555; -fx-underline: true;"
            onAction="#handleBackButton" />

    <VBox spacing="15" alignment="CENTER"
          AnchorPane.topAnchor="50" AnchorPane.leftAnchor="30" AnchorPane.rightAnchor="30">

        <!-- Header -->
        <Label text="Update Your Profile"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

        <!-- Profile Form -->
        <GridPane vgap="12" hgap="10" alignment="CENTER">
            <columnConstraints>
                <ColumnConstraints halignment="RIGHT" minWidth="100"/>
                <ColumnConstraints halignment="LEFT" minWidth="200" hgrow="ALWAYS"/>
            </columnConstraints>

            <Label text="Full Name:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="nameField" GridPane.columnIndex="1" GridPane.rowIndex="0"
                       style="-fx-pref-height: 35px; -fx-background-radius: 8px;"/>

            <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="emailField" GridPane.columnIndex="1" GridPane.rowIndex="1"
                       style="-fx-pref-height: 35px; -fx-background-radius: 8px;"/>

            <Label text="Phone:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <TextField fx:id="phoneField" GridPane.columnIndex="1" GridPane.rowIndex="2"
                       style="-fx-pref-height: 35px; -fx-background-radius: 8px;"/>

            <Label text="Address:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <TextField fx:id="addressField" GridPane.columnIndex="1" GridPane.rowIndex="3"
                       style="-fx-pref-height: 35px; -fx-background-radius: 8px;"/>

            <Label text="City:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
            <TextField fx:id="cityField" GridPane.columnIndex="1" GridPane.rowIndex="4"
                       style="-fx-pref-height: 35px; -fx-background-radius: 8px;"/>

            <Label text="State:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
            <TextField fx:id="stateField" GridPane.columnIndex="1" GridPane.rowIndex="5"
                       style="-fx-pref-height: 35px; -fx-background-radius: 8px;"/>

            <Label text="New Password:" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
            <PasswordField fx:id="passwordField" GridPane.columnIndex="1" GridPane.rowIndex="6"
                           style="-fx-pref-height: 35px; -fx-background-radius: 8px;"/>
        </GridPane>

        <!-- Status Message -->
        <Label fx:id="statusLabel" text=""
               style="-fx-text-fill: #27ae60; -fx-font-size: 14px;"/>

        <!-- Update Button -->
        <Button fx:id="updateButton" text="Update Profile" onAction="#handleUpdate"
                style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-size: 16px;
                       -fx-padding: 10px 20px; -fx-background-radius: 12px; -fx-font-weight: bold;"/>

    </VBox>
</AnchorPane>
