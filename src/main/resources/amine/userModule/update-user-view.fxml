<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.paint.LinearGradient?>
<?import javafx.scene.paint.Stop?>

<AnchorPane xmlns="http://javafx.com/javafx/11.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.amine.userController.updateuserController"
            stylesheets="@prof.css"
            styleClass="root"
            prefWidth="800" prefHeight="700">

    <!-- NavBar with proper positioning -->
    <VBox AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0" 
          AnchorPane.rightAnchor="0">
        <fx:include fx:id="navBar" source="../../navbar.fxml"/>
    </VBox>

    <!-- Main Content -->
    <VBox styleClass="main-container" alignment="CENTER"
          AnchorPane.topAnchor="60" 
          AnchorPane.bottomAnchor="20"
          AnchorPane.leftAnchor="20" 
          AnchorPane.rightAnchor="20">

        <!-- Form Container -->
        <VBox styleClass="form-container" spacing="30">
            
            <!-- Header with Back Button -->
            <HBox spacing="20" alignment="CENTER_LEFT">
                <Button text="←" styleClass="back-button" onAction="#handleBackButton"/>
                <Text text="Profile Settings" styleClass="app-title"/>
            </HBox>

            <ScrollPane styleClass="custom-scroll-pane" fitToWidth="true">
                <VBox spacing="30">
                    <!-- Profile Section -->
                    <VBox styleClass="profile-section" alignment="CENTER" spacing="15">
                        <StackPane styleClass="image-container">
                            <ImageView fx:id="profileImageView" 
                                     fitWidth="150" 
                                     fitHeight="150" 
                                     styleClass="profile-image"/>
                        </StackPane>
                        <Button text="Change Avatar" styleClass="secondary-button"/>
                        <Label text="PNG, JPG up to 5MB" styleClass="field-label"/>
                    </VBox>

                    <!-- User Information Form -->
                    <GridPane hgap="20" vgap="20">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="30"/>
                            <ColumnConstraints percentWidth="70"/>
                        </columnConstraints>

                        <!-- CIN -->
                        <Label text="CIN" styleClass="field-label" 
                               GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <Label fx:id="cinLabel" styleClass="field-input"
                               GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <!-- Full Name -->
                        <Label text="Full Name" styleClass="field-label"
                               GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <TextField fx:id="nameField" styleClass="field-input"
                                 GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        <!-- Email -->
                        <Label text="Email" styleClass="field-label"
                               GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <TextField fx:id="emailField" styleClass="field-input"
                                 GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                        <!-- Phone -->
                        <Label text="Phone" styleClass="field-label"
                               GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <TextField fx:id="phoneField" styleClass="field-input"
                                 GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                        <!-- Address -->
                        <Label text="Address" styleClass="field-label"
                               GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                        <TextField fx:id="addressField" styleClass="field-input"
                                 GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                        <!-- Birthday -->
                        <Label text="Birthday" styleClass="field-label"
                               GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                        <DatePicker fx:id="birthdayPicker" styleClass="date-picker"
                                  GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                        <!-- Password Section -->
                        <Label text="New Password" styleClass="field-label"
                               GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                        <VBox spacing="5" GridPane.rowIndex="6" GridPane.columnIndex="1">
                            <PasswordField fx:id="passwordField" 
                                         styleClass="field-input"
                                         onKeyReleased="#handlePasswordChange"/>
                            
                            <!-- Password Strength Indicator -->
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <ProgressBar fx:id="passwordStrengthBar" 
                                           progress="0.0" 
                                           prefWidth="200"/>
                                <Label fx:id="passwordStrengthLabel" 
                                      styleClass="password-strength-label"/>
                            </HBox>
                            
                            <!-- Password Requirements -->
                            <VBox fx:id="passwordRequirements" spacing="2">
                                <Label text="• At least 8 characters" styleClass="requirement-label"/>
                                <Label text="• At least one uppercase letter" styleClass="requirement-label"/>
                                <Label text="• At least one lowercase letter" styleClass="requirement-label"/>
                                <Label text="• At least one number" styleClass="requirement-label"/>
                                <Label text="• At least one special character" styleClass="requirement-label"/>
                            </VBox>
                        </VBox>

                        <!-- Bio -->
                        <Label text="Bio" styleClass="field-label"
                               GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                        <TextArea fx:id="bioField" styleClass="bio-textarea"
                                 GridPane.rowIndex="7" GridPane.columnIndex="1"
                                 wrapText="true"/>
                    </GridPane>

                    <!-- Action Buttons -->
                    <HBox spacing="20" alignment="CENTER">
                        <Button text="Cancel" styleClass="secondary-button" 
                                onAction="#handleBackButton"/>
                        <Button text="Save Changes" styleClass="primary-button"
                                onAction="#handleUpdate"/>
                    </HBox>

                    <!-- Status Message -->
                    <Label fx:id="statusLabel" styleClass="validation-label"/>
                </VBox>
            </ScrollPane>
        </VBox>
    </VBox>
</AnchorPane>