<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.paint.LinearGradient?>

<?import javafx.scene.paint.Stop?>
<AnchorPane xmlns="http://javafx.com/javafx/11.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.amine.userController.updateuserController"
            stylesheets="@profile.css"
            prefWidth="800" prefHeight="700">

    <fx:include fx:id="navBar" source="../../navbar.fxml"
                AnchorPane.topAnchor="0"
                AnchorPane.leftAnchor="0"
                AnchorPane.rightAnchor="0"/>
    <!-- Background Gradient -->
    <Rectangle width="800" height="700">
        <fill>
            <LinearGradient startX="0" startY="0" endX="1" endY="1">
                <stops>
                    <Stop offset="0" color="#0f2027"/>
                    <Stop offset="1" color="#203a43"/>
                </stops>
            </LinearGradient>
        </fill>
    </Rectangle>

    <!-- Main Content Card -->
    <VBox styleClass="main-card" alignment="TOP_CENTER"
          AnchorPane.topAnchor="40" AnchorPane.bottomAnchor="40"
          AnchorPane.leftAnchor="100" AnchorPane.rightAnchor="100">

        <!-- Header with Back Button -->
        <HBox alignment="CENTER_LEFT" styleClass="header-box">
            <Button text="←" styleClass="back-button" onAction="#handleBackButton"/>
            <Label text="PROFILE SETTINGS" styleClass="header-title"/>
        </HBox>

        <!-- Profile Content -->
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <VBox spacing="30" styleClass="content-box">

                <!-- Profile Picture Section -->
                <VBox spacing="15" alignment="CENTER" styleClass="profile-section">
                    <ImageView fx:id="profileImageView" fitWidth="120" fitHeight="120" styleClass="profile-image"/>
                    <Button text="Change Avatar" styleClass="avatar-button"/>
                    <Label text="PNG, JPG up to 5MB" styleClass="hint-text"/>
                </VBox>

                <!-- User Information Sections -->
                <GridPane hgap="20" vgap="20" styleClass="info-grid">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50"/>
                        <ColumnConstraints percentWidth="50"/>
                    </columnConstraints>

                    <!-- Row 0 -->
                    <Label text="CIN" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <Label fx:id="cinLabel" styleClass="field-value" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <!-- Row 1 -->
                    <Label text="Full Name" styleClass="field-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="nameField" styleClass="field-input" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <!-- Row 2 -->
                    <Label text="Email" styleClass="field-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <TextField fx:id="emailField" styleClass="field-input" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <!-- Row 3 -->
                    <Label text="Phone" styleClass="field-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <TextField fx:id="phoneField" styleClass="field-input" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <!-- Row 4 -->
                    <Label text="Address" styleClass="field-label" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <TextField fx:id="addressField" styleClass="field-input" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                    <!-- Row 5 -->
                    <Label text="Birthday" styleClass="field-label" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                    <DatePicker fx:id="birthdayPicker" styleClass="date-picker" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                    <Label text="New Password" styleClass="field-label" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                    <PasswordField fx:id="passwordField" styleClass="field-input" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
                    <!-- Row 6 -->
                    <Label text="Bio" styleClass="field-label" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                    <TextArea fx:id="bioField" styleClass="bio-textarea" GridPane.rowIndex="7" GridPane.columnIndex="1"
                              GridPane.rowSpan="2"/>

                    <!-- Row 7 -->

                </GridPane>

                <!-- Action Buttons -->
                <HBox spacing="30" alignment="CENTER" styleClass="actions-box">
                    <Button text="CANCEL" styleClass="cancel-button" onAction="#handleBackButton"/>
                    <Button text="SAVE CHANGES" styleClass="save-button" onAction="#handleUpdate"/>
                </HBox>

                <!-- Status Message -->
                <Label fx:id="statusLabel" styleClass="status-message"/>
            </VBox>
        </ScrollPane>
    </VBox>
</AnchorPane>