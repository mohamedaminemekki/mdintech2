<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="700.0"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.amine.userController.displayuserController">

    <!-- Back Button -->
    <Button layoutX="10" layoutY="10" onAction="#handleBackButton" text="← Back"
            style="-fx-background-color: #d9534f; -fx-text-fill: white; -fx-font-weight: bold;"/>

    <!-- Header Label -->
    <Label layoutX="50.0" layoutY="30.0" text="User Management"
           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <!-- Search Filters -->
    <HBox layoutX="50.0" layoutY="70.0" spacing="10">
        <TextField fx:id="minAgeField" promptText="Min Age" style="-fx-pref-width: 80;"/>
        <TextField fx:id="maxAgeField" promptText="Max Age" style="-fx-pref-width: 80;"/>
        <TextField fx:id="nameField" promptText="Name" style="-fx-pref-width: 120;"/>
        <TextField fx:id="cinField" promptText="CIN" style="-fx-pref-width: 120;"/>
        <TextField fx:id="addressField" promptText="email" style="-fx-pref-width: 150;"/>
        <Button text="Search" onAction="#searchUsers"
                style="-fx-background-color: #0275d8; -fx-text-fill: white;"/>
    </HBox>

    <!-- User List -->
    <ListView fx:id="usersList" layoutX="50.0" layoutY="110.0" prefHeight="340.0" prefWidth="600.0"
              style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6; -fx-border-radius: 5px;"/>

    <!-- Refresh Button -->
    <Button layoutX="550.0" layoutY="30.0" text="Refresh" onAction="#loadUsers"
            style="-fx-background-color: #5cb85c; -fx-text-fill: white;"/>
</AnchorPane>
