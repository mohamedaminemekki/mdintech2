<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.amine.loginController" styleClass="root">
    <VBox alignment="CENTER" spacing="30" styleClass="form-container" maxWidth="400">

        <Label text="Welcome to MDINTECH" styleClass="title-label" />
        <Label text="A platform providing diverse city services, from your desktop" wrapText="true" textAlignment="CENTER" styleClass="subtitle-label" maxWidth="300" />

        <VBox spacing="15" alignment="CENTER">
            <TextField fx:id="emailField" promptText="Email" styleClass="text-field" />
            <PasswordField fx:id="passwordField" promptText="Password" styleClass="password-field" />
        </VBox>

        <VBox spacing="10" alignment="CENTER">
            <Button fx:id="loginButton" onAction="#login" text="Login" styleClass="button" />
            <Separator prefWidth="200" />
            <Button fx:id="googleLoginButton" onAction="#handleGoogleLogin" text="Login with Google" styleClass="button google-button" />
        </VBox>

        <HBox spacing="20" alignment="CENTER">
            <Hyperlink onAction="#gotoSignIn" text="Create account?" styleClass="hyperlink" />
            <Hyperlink onAction="#forgotPassword" text="Forgot Password?" styleClass="hyperlink" />
        </HBox>

    </VBox>
</StackPane>
