<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<AnchorPane prefHeight="300.0" prefWidth="400.0"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.amine.ResetPasswordController"
            styleClass="root" stylesheets="@style2.css">

    <children>
        <VBox layoutX="50.0" layoutY="40.0" spacing="15.0" alignment="center"
              prefWidth="300.0" prefHeight="220.0">

            <!-- Title -->
            <Label text="Reset Your Password" styleClass="title-label" />

            <!-- New Password Field -->
            <PasswordField fx:id="newPasswordField" promptText="New Password" styleClass="text-field" />

            <!-- Confirm Password Field -->
            <PasswordField fx:id="confirmPasswordField" promptText="Confirm Password" styleClass="text-field" />

            <!-- Reset Password Button -->
            <Button fx:id="resetButton" onAction="#resetPassword" text="Reset Password" styleClass="button" />

        </VBox>
    </children>
    <Button layoutX="10" layoutY="10" onAction="#goToLoginPage" styleClass="back-button" prefWidth="50" prefHeight="30">
        <graphic>
            <ImageView fitWidth="16" fitHeight="16">
                <Image url="@../images/retournericon.png" />
            </ImageView>
        </graphic>
    </Button>
</AnchorPane>
